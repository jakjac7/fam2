# Firebase Web App configuration. These fields are public browser settings;
# access is enforced by Cloud Functions and Firestore Rules.
VITE_FIREBASE_API_KEY="YOUR_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_FUNCTIONS_REGION="asia-northeast3"

# Import only: set these in a local terminal. Never commit a service account
# file, its JSON content, or any Google Cloud credential.
# FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
# GOOGLE_APPLICATION_CREDENTIALS="C:\\safe-path\\firebase-service-account.json"
